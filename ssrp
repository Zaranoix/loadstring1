local function getCharacter(player)
	local character = player.Character

	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return character
end

local function getHead(player)
	local character = getCharacter(player)

	if not character then
		return nil, nil
	end

	local head = character:FindFirstChild("Head")

	if not head or not head:IsA("BasePart") then
		return nil, nil
	end

	return character, head
end

local function sameTeam(player)
	return LocalPlayer.Team ~= nil
		and player.Team ~= nil
		and LocalPlayer.Team == player.Team
end

local function systemActive()
	return not SYSTEM_CLOSED
end

local function aimRoleAllowed(player)
	local roleName = getRoleName(player)

	if aimRoleEnabled[roleName] == nil then
		aimRoleEnabled[roleName] = true
	end

	return aimRoleEnabled[roleName]
end

local function espRoleAllowed(player)
	local roleName = getRoleName(player)

	if espRoleEnabled[roleName] == nil then
		espRoleEnabled[roleName] = true
	end

	return espRoleEnabled[roleName]
end

local function isVisible(targetPart, targetCharacter)
	if not WALL_CHECK then
		return true
	end

	if not Camera then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local filter = {}

	if LocalPlayer.Character then
		table.insert(filter, LocalPlayer.Character)
	end

	params.FilterDescendantsInstances = filter

	local origin = Camera.CFrame.Position
	local direction = targetPart.Position - origin
	local result = workspace:Raycast(origin, direction, params)

	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(targetCharacter)
end

local function getScreenCenter()
	local viewport = Camera.ViewportSize
	return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
end

local function getScreenData(part)
	local point, onScreen = Camera:WorldToViewportPoint(part.Position)

	if not onScreen or point.Z <= 0 then
		return nil, nil
	end

	local screenPoint = Vector2.new(point.X, point.Y)
	local distanceFromCenter = (screenPoint - getScreenCenter()).Magnitude

	return screenPoint, distanceFromCenter
end

local function validAimPlayer(player)
	if player == LocalPlayer then
		return false
	end

	if not aimRoleAllowed(player) then
		return false
	end

	if AIM_TEAM_CHECK and sameTeam(player) then
		return false
	end

	return true
end

local function findNearestTarget()
	if not systemActive() or not AIMBOT_ENABLED or not Camera then
		return nil, nil
	end

	local cameraPosition = Camera.CFrame.Position
	local nearestPlayer = nil
	local nearestHead = nil
	local nearestWorldDistance = math.huge
	local nearestScreenDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if validAimPlayer(player) then
			local character, head = getHead(player)

			if character and head then
				local worldDistance = (head.Position - cameraPosition).Magnitude

				if worldDistance <= MAX_DISTANCE then
					local _, screenDistance = getScreenData(head)

					if screenDistance and screenDistance <= FOV_SIZE * 0.5 then
						if isVisible(head, character) then
							if worldDistance < nearestWorldDistance
								or (
									math.abs(worldDistance - nearestWorldDistance) < 0.01
									and screenDistance < nearestScreenDistance
								) then

								nearestWorldDistance = worldDistance
								nearestScreenDistance = screenDistance
								nearestPlayer = player
								nearestHead = head
							end
						end
					end
				end
			end
		end
	end

	return nearestPlayer, nearestHead
end

local function targetStillValid(player, part)
	if not systemActive() or not AIMBOT_ENABLED then
		return false
	end

	if not player or not player.Parent or not validAimPlayer(player) then
		return false
	end

	local character, head = getHead(player)

	if not character or not head then
		return false
	end

	if part ~= head then
		return false
	end

	if (head.Position - Camera.CFrame.Position).Magnitude > MAX_DISTANCE then
		return false
	end

	if not isVisible(head, character) then
		return false
	end

	return true
end

local function aimAt(part, deltaTime)
	if not part or not Camera then
		return
	end

	local cameraPosition = Camera.CFrame.Position
	local desired = CFrame.lookAt(cameraPosition, part.Position)

	if SENSITIVITY <= 1 then
		Camera.CFrame = desired
		return
	end

	local followSpeed = 40 / SENSITIVITY
	local alpha = 1 - math.exp(-followSpeed * deltaTime)

	Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end

local function updateTargetDot(part)
	if not part or not Camera or not systemActive() or not AIMBOT_ENABLED then
		TargetDot.Visible = false
		return
	end

	local point, onScreen = Camera:WorldToViewportPoint(part.Position)

	if not onScreen or point.Z <= 0 then
		TargetDot.Visible = false
		return
	end

	TargetDot.Position = UDim2.fromOffset(point.X, point.Y)
	TargetDot.Visible = true
end

local function removeHighlight(player)
	local data = playerHighlights[player]

	if data then
		if data.Highlight then
			data.Highlight:Destroy()
		end

		playerHighlights[player] = nil
	end
end

local function removeAllHighlights()
	for player in pairs(playerHighlights) do
		removeHighlight(player)
	end
end

local function shouldShowESP(player)
	if not systemActive() or not ESP_ENABLED then
		return false
	end

	if player == LocalPlayer then
		return false
	end

	if ESP_TEAM_CHECK and sameTeam(player) then
		return false
	end

	if not espRoleAllowed(player) then
		return false
	end

	return true
end

local function updatePlayerESP(player)
	if not shouldShowESP(player) then
		removeHighlight(player)
		return
	end

	local character = getCharacter(player)

	if not character then
		removeHighlight(player)
		return
	end

	local data = playerHighlights[player]

	if data and (not data.Highlight.Parent or data.Character ~= character) then
		removeHighlight(player)
		data = nil
	end

	if not data then
		local Highlight = Instance.new("Highlight")
		Highlight.Name = "ClientRoleESP"
		Highlight.FillTransparency = 1
		Highlight.OutlineTransparency = 0
		Highlight.Adornee = character
		Highlight.Parent = character

		data = {
			Highlight = Highlight,
			Character = character
		}

		playerHighlights[player] = data
	end

	local highlight = data.Highlight
	local roleColor = getRoleColor(player)

	highlight.Adornee = character
	highlight.FillColor = roleColor
	highlight.OutlineColor = roleColor
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.DepthMode = ESP_THROUGH_WALLS
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded
	highlight.Enabled = true
end

local function updateAllESP()
	if not systemActive() or not ESP_ENABLED then
		removeAllHighlights()
		return
	end

	local present = {}

	for _, player in ipairs(Players:GetPlayers()) do
		present[player] = true
		updatePlayerESP(player)
	end

	for player in pairs(playerHighlights) do
		if not present[player] then
			removeHighlight(player)
		end
	end
end

local function disconnectPlayer(player)
	local list = playerConnections[player]

	if list then
		for _, connection in ipairs(list) do
			connection:Disconnect()
		end

		playerConnections[player] = nil
	end
end

local function setupPlayer(player)
	if player == LocalPlayer then
		return
	end

	disconnectPlayer(player)

	local list = {}
	playerConnections[player] = list

	table.insert(list, player.CharacterAdded:Connect(function()
		removeHighlight(player)

		task.defer(function()
			task.wait(0.1)

			if not SYSTEM_CLOSED then
				updatePlayerESP(player)
			end
		end)
	end))

	table.insert(list, player:GetPropertyChangedSignal("Team"):Connect(function()
		removeHighlight(player)
		updatePlayerESP(player)

		if currentTarget == player then
			currentTarget = nil
			currentTargetPart = nil
			TargetDot.Visible = false
		end
	end))

	updatePlayerESP(player)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

track(Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end))

track(Players.PlayerRemoving:Connect(function(player)
	removeHighlight(player)
	disconnectPlayer(player)

	if currentTarget == player then
		currentTarget = nil
		currentTargetPart = nil
		TargetDot.Visible = false
	end
end))

local draggingWindow = false
local dragStart = nil
local startPosition = nil

track(Header.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingWindow = true
		dragStart = input.Position
		startPosition = Main.Position
	end
end))

track(UserInputService.InputChanged:Connect(function(input)
	if not draggingWindow or not dragStart or not startPosition then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart
		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end))

track(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		draggingWindow = false
	end
end))

local function updateFOV()
	if SYSTEM_CLOSED or not Camera then
		FOV.Visible = false
		return
	end

	local center = getScreenCenter()

	FOV.Size = UDim2.fromOffset(FOV_SIZE, FOV_SIZE)
	FOV.Position = UDim2.fromOffset(center.X, center.Y)
	FOV.Visible = true
end

local function setHidden(hidden)
	if SYSTEM_CLOSED then
		return
	end

	SYSTEM_HIDDEN = hidden
	Main.Visible = not hidden
	updateFOV()
end

local function closeSystem()
	if SYSTEM_CLOSED then
		return
	end

	SYSTEM_CLOSED = true
	currentTarget = nil
	currentTargetPart = nil

	removeAllHighlights()

	for player in pairs(playerConnections) do
		disconnectPlayer(player)
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end

	table.clear(connections)

	RunService:UnbindFromRenderStep("ThirdPersonCombatMenuRender")

	if ScreenGui then
		ScreenGui:Destroy()
	end
end

track(ExitButton.MouseButton1Click:Connect(function()
	closeSystem()
end))

track(ExitButton.MouseEnter:Connect(function()
	ExitButton.BackgroundColor3 = Color3.fromRGB(170, 50, 75)
end))

track(ExitButton.MouseLeave:Connect(function()
	ExitButton.BackgroundColor3 = Color3.fromRGB(136, 42, 62)
end))

track(UserInputService.InputBegan:Connect(function(input)
	if input.KeyCode == HIDE_KEY then
		setHidden(not SYSTEM_HIDDEN)
	end
end))

local espTimer = 0

RunService:BindToRenderStep(
	"ThirdPersonCombatMenuRender",
	10000,
	function(deltaTime)
		if SYSTEM_CLOSED then
			return
		end

		Camera = workspace.CurrentCamera

		if not Camera then
			return
		end

		updateFOV()

		espTimer += deltaTime

		if espTimer >= 0.12 then
			espTimer = 0
			updateAllESP()
		end

		if not systemActive() or not AIMBOT_ENABLED then
			currentTarget = nil
			currentTargetPart = nil
			TargetDot.Visible = false
			return
		end

		local rightMouseDown = UserInputService:IsMouseButtonPressed(AIM_KEY)

		if not rightMouseDown then
			currentTarget = nil
			currentTargetPart = nil
			TargetDot.Visible = false
			return
		end

		if currentTarget and currentTargetPart then
			if not targetStillValid(currentTarget, currentTargetPart) then
				currentTarget = nil
				currentTargetPart = nil
			end
		end

		if not currentTarget then
			currentTarget, currentTargetPart = findNearestTarget()
		end

		if currentTarget and currentTargetPart then
			aimAt(currentTargetPart, deltaTime)
			updateTargetDot(currentTargetPart)
		else
			TargetDot.Visible = false
		end
	end
)

updateRoleCanvases()
updateFOV()
updateAllESP()
