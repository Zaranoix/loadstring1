ResizeHandle.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	resizingWindow = true
	draggingWindow = false

	resizeStart = input.Position
	resizeStartSize = Main.Size

	ResizeHandle.TextColor3 = Theme.AccentBright
end)

Header.InputBegan:Connect(function(input)
	if resizingWindow then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local inputPosition = input.Position

	local closePosition = CloseButton.AbsolutePosition
	local closeSize = CloseButton.AbsoluteSize

	if inputPosition.X >= closePosition.X
		and inputPosition.X <= closePosition.X + closeSize.X
		and inputPosition.Y >= closePosition.Y
		and inputPosition.Y <= closePosition.Y + closeSize.Y then
		return
	end

	draggingWindow = true
	dragStart = input.Position
	startPosition = Main.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if resizingWindow
		and resizeStart
		and resizeStartSize then

		local delta =
			input.Position
			- resizeStart

		resizeWindow(delta)
		return
	end

	if draggingWindow
		and dragStart
		and startPosition then

		local delta =
			input.Position
			- dragStart

		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		if resizingWindow then
			resizingWindow = false
			resizeStart = nil
			resizeStartSize = nil

			tween(
				ResizeHandle,
				{
					TextColor3 = Theme.TextMuted
				},
				0.15
			)
		end

		if draggingWindow then
			draggingWindow = false
			dragStart = nil
			startPosition = nil
		end
	end
end)

TextChatService.MessageReceived:Connect(function(message)
