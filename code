	local speaker = Players:GetPlayerByUserId(
		textSource.UserId
	)

	if not speaker then
		return
	end

	local packet = {
		UserId = speaker.UserId,
		Username = speaker.Name,
		DisplayName = speaker.DisplayName,
		TeamName = getRoleName(speaker),
		RoleColor = getRoleColor(speaker),
		Text = tostring(message.Text or ""),
		Time = os.date("%H:%M")
	}

	addPacket(packet)
end)

