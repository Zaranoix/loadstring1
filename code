local function acquireRow()
	local row = table.remove(rowPool)

	if not row then
		row = createMessageRow()
	end

	row.Root.Visible = true
	row.Root.Parent = MessageList

	return row
end

local function releaseRow(row)
	row.Root.Visible = false
	row.Root.Parent = nil
	row.Root.BackgroundColor3 = Theme.Panel
	row.Stroke.Transparency = 0.6

	table.insert(rowPool, row)
end

local function releaseAllRows()
	for i = #activeRows, 1, -1 do
		local row = activeRows[i]
		activeRows[i] = nil

		releaseRow(row)
	end
end

local function applyPacketToRow(row, packet)
	local roleWidth = math.clamp(
		#packet.TeamName * 6 + 24,
		68,
		150
	)

	row.Root.LayoutOrder = packet.Serial

	row.Accent.BackgroundColor3 = packet.RoleColor

	row.Role.Size = UDim2.fromOffset(
		roleWidth,
		20
	)

	row.Role.BackgroundColor3 = packet.RoleColor:Lerp(
		Theme.Panel,
		0.78
	)

	row.Role.TextColor3 = packet.RoleColor:Lerp(
		Color3.new(1, 1, 1),
		0.55
	)

	row.Role.Text = packet.TeamName
	row.RoleStroke.Color = packet.RoleColor

	row.Identity.Position = UDim2.fromOffset(
		roleWidth + 8,
		0
	)

	row.Identity.Size = UDim2.new(
		1,
		-roleWidth - 70,
		0,
		20
	)

	row.Identity.Text = string.format(
		'<font color="#F2F3F8"><b>%s</b></font>  <font color="#797D91">@%s</font>',
		escapeRichText(packet.DisplayName),
		escapeRichText(packet.Username)
	)

	row.Time.Text = packet.Time
	row.Message.Text = packet.Text
end

local function updateEmptyState()
	if #activeRows > 0 then
		EmptyState.Visible = false
		return
	end

	EmptyState.Visible = true

	if searchQuery ~= "" then
		EmptyTitle.Text = "NO RESULTS"
		EmptySubtitle.Text = "No stored messages match your search"
	elseif selectedTab ~= "GLOBAL" then
		EmptyTitle.Text = "NO MESSAGES"
		EmptySubtitle.Text = "No stored messages from " .. selectedTab
	else
		EmptyTitle.Text = "NO MESSAGES"
		EmptySubtitle.Text = "Waiting for server communication"
	end
end

local function updateStats()
	HeaderCount.Text = tostring(#messages) .. " MSG"

	StatsLabel.Text = string.format(
		"%s  •  %d VISIBLE  •  %d STORED",
		selectedTab,
		#activeRows,
		#messages
	)

	updateEmptyState()
end

local function updateTabCounts()
	for name, data in pairs(tabButtons) do
		data.Count.Text = tostring(
			getCount(name)
		)
	end
end

local function scrollToBottom()
	task.defer(function()
		task.wait()

		local contentHeight =
			MessageLayout.AbsoluteContentSize.Y

		local windowHeight =
			MessageList.AbsoluteWindowSize.Y

		local y = math.max(
			0,
			contentHeight - windowHeight + 18
		)

		MessageList.CanvasPosition = Vector2.new(
			0,
			y
		)
	end)
end

local function renderMessages()
	releaseAllRows()

	local matching = {}

	for index = #messages, 1, -1 do
		local packet = messages[index]

		if messageMatches(packet) then
			table.insert(
				matching,
				packet
			)

			if #matching >= MAX_VISIBLE_MESSAGES then
				break
			end
		end
	end

	for index = #matching, 1, -1 do
		local packet = matching[index]
		local row = acquireRow()

		applyPacketToRow(
			row,
			packet
		)

		table.insert(
			activeRows,
			row
		)
	end

	updateStats()
	updateTabCounts()

	if #activeRows > 0 then
		scrollToBottom()
	end
end

local function updateTabVisuals()
	for name, data in pairs(tabButtons) do
		local selected = name == selectedTab

		if selected then
			data.Button.BackgroundColor3 =
				Theme.PanelHover

			data.Stroke.Color =
				Theme.Accent

			data.Stroke.Transparency =
				0.25

			data.Label.TextColor3 =
				Theme.Text

			data.CountFrame.BackgroundColor3 =
				Theme.AccentDark

			data.Count.TextColor3 =
				Theme.AccentBright
		else
			data.Button.BackgroundColor3 =
				Theme.PanelLight

			data.Stroke.Color =
				Theme.Border

			data.Stroke.Transparency =
				0.6

			data.Label.TextColor3 =
				data.Color

			data.CountFrame.BackgroundColor3 =
				Color3.fromRGB(31, 32, 42)

			data.Count.TextColor3 =
				Theme.TextMuted
		end
	end
end

local function selectTab(name)
	if not tabButtons[name] then
		return
	end

	selectedTab = name

	updateTabVisuals()
	renderMessages()
end

local function clearTabs()
	for _, data in pairs(tabButtons) do
		if data.Button then
			data.Button:Destroy()
		end
	end

	table.clear(tabButtons)
end

local function makeTab(name, color, layoutOrder)
	local buttonWidth = math.clamp(
		#name * 7 + 68,
		100,
		190
	)

	local Button = create("TextButton", {
		Name = name,
		Size = UDim2.fromOffset(buttonWidth, 30),
		BackgroundColor3 = Theme.PanelLight,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = layoutOrder,
		ZIndex = 13
	}, Tabs)

	addCorner(Button, 7)

	local Stroke = addStroke(
		Button,
		Theme.Border,
		0.6,
		1
	)

	local Dot = create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(6, 6),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = 14
	}, Button)

	addCorner(Dot, 10)

	local Label = create("TextLabel", {
		Position = UDim2.fromOffset(21, 0),
		Size = UDim2.new(1, -53, 1, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = color,
		TextSize = 9,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 14
	}, Button)

	local CountFrame = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(25, 18),
		BackgroundColor3 = Color3.fromRGB(31, 32, 42),
		BorderSizePixel = 0,
		ZIndex = 14
	}, Button)

	addCorner(CountFrame, 5)

	local Count = create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "0",
		TextColor3 = Theme.TextMuted,
		TextSize = 8,
		Font = Enum.Font.GothamBold,
		ZIndex = 15
	}, CountFrame)

	tabButtons[name] = {
		Button = Button,
		Stroke = Stroke,
		Label = Label,
		Count = Count,
		CountFrame = CountFrame,
		Dot = Dot,
		Color = color
	}

	Button.MouseButton1Click:Connect(function()
		selectTab(name)
	end)

	Button.MouseEnter:Connect(function()
		if selectedTab ~= name then
			tween(
				Button,
				{
					BackgroundColor3 = Theme.PanelHover
				},
				0.12
			)
		end
	end)

	Button.MouseLeave:Connect(function()
		if selectedTab ~= name then
			tween(
				Button,
				{
					BackgroundColor3 = Theme.PanelLight
				},
				0.15
			)
		end
	end)
end

local function rebuildTabs()
	local previousTab = selectedTab

	clearTabs()

	makeTab(
		"GLOBAL",
		Theme.AccentBright,
		1
	)

	local teamList = {}

	for _, team in ipairs(Teams:GetChildren()) do
		if team:IsA("Team") then
			table.insert(
				teamList,
				team
			)
		end
	end

	table.sort(
		teamList,
		function(a, b)
			return a.Name:lower() < b.Name:lower()
		end
	)

	for index, team in ipairs(teamList) do
		makeTab(
			team.Name,
			team.TeamColor.Color,
			index + 1
		)
	end

	makeTab(
		"NO TEAM",
		Color3.fromRGB(170, 174, 190),
		#teamList + 2
	)

	if tabButtons[previousTab] then
		selectedTab = previousTab
	else
		selectedTab = "GLOBAL"
	end

	updateTabVisuals()
	updateTabCounts()

	task.defer(function()
		Tabs.CanvasSize = UDim2.fromOffset(
			TabsLayout.AbsoluteContentSize.X + 12,
			0
		)
	end)
end

local function addVisiblePacket(packet)
	if not messageMatches(packet) then
		updateStats()
		updateTabCounts()
		return
	end

	while #activeRows >= MAX_VISIBLE_MESSAGES do
		local oldestRow = table.remove(
			activeRows,
			1
		)

		releaseRow(oldestRow)
	end

	local row = acquireRow()

	applyPacketToRow(
		row,
		packet
	)

	table.insert(
		activeRows,
		row
	)

	updateStats()
	updateTabCounts()
	scrollToBottom()
end

local function addPacket(packet)
	messageSerial += 1
	packet.Serial = messageSerial

	packet.SearchText = string.lower(
		packet.Username
			.. " "
			.. packet.DisplayName
			.. " "
			.. packet.TeamName
			.. " "
			.. packet.Text
	)

	table.insert(
		messages,
		packet
	)

	incrementCount(
		packet.TeamName,
		1
	)

	while #messages > MAX_STORED_MESSAGES do
		local removed = table.remove(
			messages,
			1
		)

		if removed then
			incrementCount(
				removed.TeamName,
				-1
			)
		end
	end

	addVisiblePacket(packet)
end

local function clearMessages()
	table.clear(messages)
	table.clear(messageCounts)

	releaseAllRows()

	updateTabCounts()
	updateStats()

	MessageList.CanvasPosition = Vector2.new()
end

local function updateScale()
	if not Camera then
		return
	end

	local viewportWidth = Camera.ViewportSize.X

	if viewportWidth < 800 then
		MainScale.Scale = math.clamp(
			viewportWidth / 800,
			0.65,
			1
		)
	else
		MainScale.Scale = 1
	end
end

local function resizeWindow(delta)
	local scale = MainScale.Scale

	if scale <= 0 then
		scale = 1
	end

	local adjustedDelta = delta / scale

	local newWidth =
		resizeStartSize.X.Offset
		+ adjustedDelta.X

	local newHeight =
		resizeStartSize.Y.Offset
		+ adjustedDelta.Y

	local maxWidth = 1600
	local maxHeight = 1000

	if Camera then
		maxWidth = math.max(
			MIN_WIDTH,
			Camera.ViewportSize.X / scale - 25
		)

		maxHeight = math.max(
			MIN_HEIGHT,
			Camera.ViewportSize.Y / scale - 25
		)
	end

	newWidth = math.clamp(
		newWidth,
		MIN_WIDTH,
		maxWidth
	)

	newHeight = math.clamp(
		newHeight,
		MIN_HEIGHT,
		maxHeight
	)

	Main.Size = UDim2.fromOffset(
		newWidth,
		newHeight
	)
end

