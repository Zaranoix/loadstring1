local function getCount(name)
	if name == "GLOBAL" then
		return #messages
	end

	return messageCounts[name] or 0
end

local function incrementCount(name, amount)
	messageCounts[name] = math.max(
		0,
		(messageCounts[name] or 0) + amount
	)
end

local function messageMatches(packet)
	if selectedTab ~= "GLOBAL" and packet.TeamName ~= selectedTab then
		return false
	end

	if searchQuery == "" then
		return true
	end

	return string.find(
		packet.SearchText,
		searchQuery,
		1,
		true
	) ~= nil
end

